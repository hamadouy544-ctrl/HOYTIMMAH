{
  "manifest_version": 3,
  "name": "HOYTIMMAH - Comprendre Facilement",
  "version": "1.0.0",
  "description": "Traduit les interfaces financieres en Fulfulde et Haoussa - Maroua",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HOYTIMMAH"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["alert.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/*.json", "audio/*.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}